# 18. PREPARE MACHINE LEARNING
# ============================

print("\n" + "=" * 65)
print("11. LOGISTIC REGRESSION MODEL")
print("=" * 65)

# Use exactly the six predictors listed in the PPT.
numeric_features = [
    "Sales",
    "Discount",
    "Quantity"
]

categorical_features = [
    "Region",
    "Category",
    "Payment_Mode"
]

feature_columns = numeric_features + categorical_features

# Profit is deliberately NOT used as a predictor.
X = df_model[feature_columns].copy()

# Y = profitable, N = loss.
y = (
    df_model["Profit_Status"] == "Y"
).astype(int)

# Remove rows where all target classes cannot be represented
# in the train/test split.
class_counts = y.value_counts()

if len(class_counts) != 2 or class_counts.min() < 2:
    raise ValueError(
        "At least two records from each target class are required "
        "for stratified train/test evaluation."
    )

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("Total modeling records:", len(X))
print("Training records:", len(X_train))
print("Testing records:", len(X_test))


# ============================
# 19. PREPROCESSING PIPELINE
# ============================

numeric_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="median")),
    ("scaler", StandardScaler())
])

categorical_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("encoder", OneHotEncoder(handle_unknown="ignore"))
])

preprocessor = ColumnTransformer(
    transformers=[
        ("numeric", numeric_transformer, numeric_features),
        ("categorical", categorical_transformer,
         categorical_features)
    ]
)

model = Pipeline(steps=[
    ("preprocessor", preprocessor),
    ("classifier", LogisticRegression(max_iter=1000))
])


# ============================
# 20. TRAIN THE MODEL
# ============================

model.fit(X_train, y_train)

print("\nLogistic Regression model trained successfully!")


# ============================
# 21. PREDICT TEST RESULTS
# ============================

y_pred = model.predict(X_test)

y_probability = model.predict_proba(X_test)[:, 1]


